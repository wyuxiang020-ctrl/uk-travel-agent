# Copy to .env.local, fill locally, and restart the preview. Never paste keys into chat.
# No outbound model call is allowed until this is explicitly true.
TRAVEL_MODEL_ENABLED=false
# New UK route-to-day workflow: enable only after explicit permission to resume paid tests.
# Uses the same durable 20261011-gpt41-first ledger; never reset the budget.
TRAVEL_UK_DAILY_ENABLED=false
# OpenAI-compatible Chat Completions base URL, including the provider's API version path.
# The app appends /chat/completions. No default provider or model is selected.
TRAVEL_MODEL_BASE_URL=
TRAVEL_MODEL_NAME=
TRAVEL_MODEL_API_KEY=
# Use max_tokens only if your chosen compatible service requires that legacy field.
TRAVEL_MODEL_TOKEN_FIELD=max_completion_tokens
TRAVEL_MODEL_MAX_OUTPUT_TOKENS=6000
TRAVEL_MODEL_MAX_ROUNDS=10
TRAVEL_MODEL_TIMEOUT_MS=45000
# Optional local GPT-4.1 test cap (maximum $1). Keep the same ID for this test round.
TRAVEL_MODEL_TEST_BUDGET_USD=
TRAVEL_MODEL_TEST_BUDGET_ID=

# Demand-understanding chat: keep false until paid calls are explicitly resumed.
TRAVEL_INTAKE_ENABLED=false
